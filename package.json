{
	"name": "nuxt-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"build:mock": "cross-env NUXT_PUBLIC_USE_MOCK_DATA=true nuxt build",
		"build:prod": "cross-env NUXT_PUBLIC_USE_MOCK_DATA=false nuxt build",
		"build:static": "cross-env NUXT_PUBLIC_USE_MOCK_DATA=true nuxt generate",
		"dev": "nuxt dev",
		"dev:mock": "cross-env NUXT_PUBLIC_USE_MOCK_DATA=true nuxt dev",
		"start": "node .output/server/index.mjs",
		"preview:static": "npx serve .output/public",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"prepare": "husky || true",
		"format": "pnpm strip-comments && prettier --write \"**/*.{js,ts,vue,json,css,scss,md}\"",
		"format:check": "prettier --check \"**/*.{js,ts,vue,json,css,scss,md}\"",
		"strip-comments": "node scripts/strip-comments.js",
		"lint:fix": "eslint . --fix",
		"migrate:data": "node scripts/migrate-data.js",
		"migrate:fipe": "powershell -ExecutionPolicy Bypass -File scripts/migrate-fipe.ps1"
	},
	"lint-staged": {
		"*.{vue,ts,js,mjs}": [
			"node scripts/strip-comments.js",
			"prettier --write",
			"eslint --fix"
		]
	},
	"dependencies": {
		"@nuxt/eslint": "^0.5.7",
		"@nuxt/icon": "1.10.3",
		"@vite-pwa/nuxt": "^1.0.7",
		"chart.js": "^4.5.1",
		"idb": "^8.0.3",
		"maska": "^3.2.0",
		"vue": "latest",
		"vue-chartjs": "^5.3.3",
		"zod": "^3.25.76"
	},
	"packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
	"devDependencies": {
		"@iconify-json/heroicons": "^1.2.3",
		"@iconify-json/uil": "^1.2.3",
		"@nuxt/image": "1.11.0",
		"@nuxtjs/tailwindcss": "^6.14.0",
		"autoprefixer": "^10.4.22",
		"cross-env": "^7.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"nuxt": "^3.20.1",
		"prettier": "^3.6.2",
		"strip-comments": "^2.0.1",
		"tailwindcss": "3.4.15",
		"typescript": "^5.9.3",
		"vue-tsc": "^2.2.12"
	}
}
